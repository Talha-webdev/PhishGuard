# PhishGuard environment configuration
# Copy this file to .env and fill in values if your backend uses them.

API_HOST=127.0.0.1
API_PORT=8000

# If your extension connects to a deployed backend, put its URL here.
# Example:
# API_BASE_URL=https://your-api-domain.example
API_BASE_URL=http://127.0.0.1:8000
